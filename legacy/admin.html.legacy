<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Beleco — Dashboard</title>
  <link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png">
  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#2B1D14">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Beleco">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Manrope:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --bg: #FFFFFF;
      --dark: #1E140D;
      --primary: #C2530C;
      --primary-dark: #A93F01;
      --text: #2B1D14;
      --muted: #8A7368;
      --muted-light: #C9B7AB;
      --accent-peach: #FFE3CC;
      --gold: #C98A3E;
      --border: #F0E4DA;
      --green: #2E8B57;
      --red: #B3271C;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      min-height: 100%;
      height: calc(100dvh + env(safe-area-inset-bottom, 0px));
      min-height: -webkit-fill-available;
      background: var(--bg);
      font-family: 'Manrope', sans-serif;
      color: var(--text);
      overflow: hidden;
      overscroll-behavior: none;
    }

    .app {
      max-width: 520px;
      margin: 0 auto;
      width: 100%;
      height: 100%;
      height: calc(100dvh + env(safe-area-inset-bottom, 0px));
      display: flex;
      flex-direction: column;
      position: relative;
      overflow: hidden;
    }

    /* --- gate screen (checking / denied) --- */
    .gate {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 40px;
      gap: 14px;
    }

    .gate p {
      color: var(--muted);
      font-size: 13.5px;
    }

    .gate a {
      color: var(--primary-dark);
      font-weight: 700;
    }

    /* --- topbar --- */
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: calc(16px + env(safe-area-inset-top, 0px)) 18px 10px;
    }

    .topbar .brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .topbar .logo {
      height: 26px;
      width: auto;
    }

    .admin-badge {
      background: var(--dark);
      color: #fff;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .5px;
      padding: 4px 9px;
      border-radius: 999px;
    }

    .exit-btn {
      background: var(--accent-peach);
      border: none;
      border-radius: 999px;
      padding: 8px 14px;
      font-family: 'Manrope';
      font-weight: 700;
      font-size: 12px;
      color: var(--primary-dark);
      cursor: pointer;
    }

    /* --- panels --- */
    .panels {
      flex: 1;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      position: relative;
    }

    .panel {
      display: none;
      min-height: 100%;
      flex-direction: column;
      padding-bottom: calc(84px + env(safe-area-inset-bottom, 0px));
      box-sizing: border-box;
    }

    .panel.active {
      display: flex;
    }

    .placeholder {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 40px 32px 120px;
      color: var(--muted);
    }

    .placeholder .icon-wrap {
      width: 76px;
      height: 76px;
      border-radius: 50%;
      background: var(--accent-peach);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 18px;
    }

    .placeholder .icon-wrap svg {
      width: 34px;
      height: 34px;
      stroke: var(--primary-dark);
      fill: none;
      stroke-width: 1.6;
    }

    .placeholder h2 {
      font-family: 'Fraunces', serif;
      font-weight: 600;
      font-size: 19px;
      color: var(--text);
      margin: 0 0 6px;
    }

    .placeholder p {
      font-size: 13.5px;
      line-height: 1.7;
      margin: 0;
      max-width: 280px;
    }

    /* --- bottom tab bar --- */
    .tabbar {
      position: absolute;
      bottom: calc(14px + env(safe-area-inset-bottom, 0px));
      left: 16px;
      right: 16px;
      max-width: 488px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-around;
      background: rgba(255, 251, 248, 0.92);
      -webkit-backdrop-filter: blur(16px);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(240, 228, 218, 0.9);
      border-radius: 999px;
      padding: 6px 10px;
      box-shadow: 0 14px 30px -14px rgba(43, 29, 20, 0.28);
      z-index: 50;
    }

    .tab-btn {
      background: none;
      border: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      padding: 6px 4px;
      cursor: pointer;
      color: var(--muted-light);
      flex: 1;
      font-family: 'Manrope';
    }

    .tab-btn svg {
      width: 22px;
      height: 22px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.7;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .tab-btn span {
      font-size: 10.5px;
      font-weight: 700;
      color: currentColor;
    }

    .tab-btn.active {
      color: var(--primary-dark);
    }

    .tab-btn.active svg {
      stroke: var(--primary-dark);
    }

    /* --- listings tab --- */
    .dash-header {
      padding: 16px 18px 10px;
    }

    .dash-title {
      font-family: 'Fraunces', serif;
      font-weight: 600;
      font-size: 19px;
      margin: 0;
    }

    .upload-form {
      padding: 8px 18px 20px;
    }

    .df-field {
      margin-bottom: 12px;
    }

    .df-field label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 5px;
    }

    .df-field input,
    .df-field select {
      width: 100%;
      padding: 12px 14px;
      border-radius: 12px;
      border: 1.5px solid var(--border);
      background: #FFFBF8;
      font-family: 'Manrope';
      font-size: 14px;
      color: var(--text);
      outline: none;
    }

    .df-field input:focus,
    .df-field select:focus {
      border-color: var(--primary);
    }

    .placements-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .placement-chip {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 8px 12px;
      border-radius: 999px;
      border: 1.3px solid var(--border);
      background: #FFFBF8;
      font-size: 11.5px;
      font-weight: 700;
      cursor: pointer;
    }

    .placement-chip input {
      accent-color: var(--primary);
      width: 14px;
      height: 14px;
    }

    .image-drop {
      border: 1.5px dashed var(--border);
      border-radius: 14px;
      padding: 20px;
      text-align: center;
      cursor: pointer;
      color: var(--muted);
      font-size: 12.5px;
      background: #FFFBF8;
      margin-bottom: 12px;
    }

    .image-drop img {
      max-width: 100%;
      max-height: 120px;
      border-radius: 10px;
      display: none;
    }

    .upload-submit-btn {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 14px;
      background: var(--primary);
      color: #fff;
      font-family: 'Manrope';
      font-weight: 700;
      font-size: 14.5px;
      cursor: pointer;
    }

    .upload-submit-btn:disabled {
      background: var(--muted-light);
    }

    .upload-note {
      font-size: 11.5px;
      color: var(--green);
      text-align: center;
      margin-top: 8px;
      display: none;
    }

    .upload-error {
      font-size: 11.5px;
      color: var(--red);
      text-align: center;
      margin-top: 8px;
      display: none;
    }

    .products-section-title {
      font-family: 'Fraunces', serif;
      font-weight: 600;
      font-size: 15.5px;
      padding: 8px 18px 10px;
    }

    .products-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      padding: 0 18px 100px;
    }

    .product-tile {
      border: 1.3px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
    }

    .product-tile img {
      width: 100%;
      height: 120px;
      object-fit: cover;
      display: block;
    }

    .pt-body {
      padding: 9px 10px;
    }

    .pt-name {
      font-size: 12px;
      font-weight: 700;
      margin: 0 0 3px;
    }

    .pt-price {
      font-size: 12px;
      font-weight: 800;
      color: var(--primary-dark);
      margin: 0 0 6px;
    }

    .pt-delete {
      width: 100%;
      padding: 6px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: none;
      color: var(--red);
      font-family: 'Manrope';
      font-weight: 700;
      font-size: 10.5px;
      cursor: pointer;
    }

    /* --- BAZAAR tab: "souq ticket" identity --- */
    :root {
      --bz-gold-1: #E7A33E;
      --bz-gold-2: #C2530C;
      --bz-ink: #2B1D14;
      --bz-paper: #FFFCF8;
    }

    @keyframes bzFadeUp {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes bzPulseRing {
      0% {
        box-shadow: 0 0 0 0 rgba(194, 83, 12, .45);
      }

      70% {
        box-shadow: 0 0 0 14px rgba(194, 83, 12, 0);
      }

      100% {
        box-shadow: 0 0 0 0 rgba(194, 83, 12, 0);
      }
    }

    @keyframes bzSweep {
      0% {
        transform: translateY(-100%);
      }

      100% {
        transform: translateY(100%);
      }
    }

    @keyframes bzPop {
      0% {
        opacity: 0;
        transform: scale(.9) translateY(8px);
      }

      60% {
        opacity: 1;
        transform: scale(1.02);
      }

      100% {
        transform: scale(1);
      }
    }

    @keyframes bzCheckPop {
      0% {
        transform: scale(0) rotate(-20deg);
        opacity: 0;
      }

      60% {
        transform: scale(1.25) rotate(4deg);
        opacity: 1;
      }

      100% {
        transform: scale(1) rotate(0);
      }
    }

    @keyframes bzShimmer {
      0% {
        background-position: 0% 50%;
      }

      100% {
        background-position: 200% 50%;
      }
    }

    @media (prefers-reduced-motion: reduce) {

      .bz-row,
      .bz-sale-card,
      .scan-btn,
      #bzScanSweep {
        animation: none !important;
      }
    }

    .bz-header-strip {
      height: 6px;
      margin: 0 18px 12px;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--bz-gold-1), var(--bz-gold-2), var(--bz-gold-1));
      background-size: 200% 100%;
      animation: bzShimmer 5s linear infinite;
    }

    .bazaar-subnav {
      position: relative;
      display: flex;
      gap: 6px;
      padding: 0 18px 16px;
    }

    .bz-pill {
      position: relative;
      z-index: 2;
      flex: 1;
      padding: 10px 8px;
      border-radius: 999px;
      border: none;
      background: none;
      font-family: 'Manrope';
      font-weight: 800;
      font-size: 12.5px;
      color: var(--muted);
      cursor: pointer;
      text-align: center;
      transition: color .25s ease;
    }

    .bz-pill.active {
      color: #fff;
    }

    .bz-subnav-track {
      position: absolute;
      inset: 0 18px;
      z-index: 0;
      background: #F3E9DD;
      border-radius: 999px;
    }

    .bz-subnav-indicator {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 18px;
      border-radius: 999px;
      z-index: 1;
      background: linear-gradient(135deg, var(--bz-gold-2), var(--dark));
      transition: transform .32s cubic-bezier(.65, .05, .36, 1), width .32s cubic-bezier(.65, .05, .36, 1);
      box-shadow: 0 4px 10px rgba(169, 63, 1, .28);
    }

    .bz-section {
      display: none;
      flex-direction: column;
      flex: 1;
    }

    .bz-section.active {
      display: flex;
    }

    .bz-card {
      margin: 0 18px 14px;
      padding: 14px;
      border: 1.3px solid var(--border);
      border-radius: 16px;
      background: var(--bz-paper);
      animation: bzFadeUp .4s ease both;
    }

    .bz-card h3 {
      font-family: 'Fraunces', serif;
      font-weight: 600;
      font-size: 14.5px;
      margin: 0 0 8px;
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .bz-card p.hint {
      font-size: 11.5px;
      color: var(--muted);
      line-height: 1.6;
      margin: 0 0 10px;
    }

    .bz-file-btn {
      display: block;
      width: 100%;
      text-align: center;
      padding: 12px;
      border-radius: 12px;
      border: 1.5px dashed var(--muted-light);
      background: #fff;
      color: var(--primary-dark);
      font-family: 'Manrope';
      font-weight: 700;
      font-size: 12.5px;
      cursor: pointer;
      margin-bottom: 10px;
      transition: border-color .2s ease, transform .12s ease;
    }

    .bz-file-btn:active {
      transform: scale(.98);
      border-color: var(--primary);
    }

    .bz-inline {
      display: flex;
      gap: 8px;
    }

    .bz-inline input {
      flex: 1;
    }

    .bz-inline button {
      flex-shrink: 0;
      padding: 0 16px;
      border: none;
      border-radius: 12px;
      background: var(--dark);
      color: #fff;
      font-family: 'Manrope';
      font-weight: 700;
      font-size: 12.5px;
      cursor: pointer;
      transition: transform .12s ease;
    }

    .bz-inline button:active {
      transform: scale(.94);
    }

    .bz-status {
      font-size: 11.5px;
      margin-top: 8px;
    }

    .bz-status.ok {
      color: var(--green);
    }

    .bz-status.err {
      color: var(--red);
    }

    .bz-list {
      padding: 0 18px 100px;
    }

    .bz-row {
      position: relative;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 10px 10px 16px;
      border-radius: 14px;
      margin-bottom: 12px;
      background: #fff;
      border: 1.3px solid var(--border);
      border-inline-start: none;
      box-shadow: 0 1px 3px rgba(43, 29, 20, .05);
      animation: bzFadeUp .38s ease both;
      transition: transform .15s ease, box-shadow .15s ease;
    }

    .bz-row:nth-child(1) {
      animation-delay: .02s;
    }

    .bz-row:nth-child(2) {
      animation-delay: .06s;
    }

    .bz-row:nth-child(3) {
      animation-delay: .1s;
    }

    .bz-row:nth-child(4) {
      animation-delay: .14s;
    }

    .bz-row:nth-child(5) {
      animation-delay: .18s;
    }

    .bz-row:nth-child(6) {
      animation-delay: .22s;
    }

    .bz-row:active {
      transform: scale(.99);
    }

    /* ticket-stub perforation: dashed edge + punched notches, like a market price tag */
    .bz-row::before {
      content: '';
      position: absolute;
      inset-block: 6px;
      inset-inline-start: 0;
      width: 0;
      border-inline-start: 1.5px dashed var(--muted-light);
    }

    .bz-row::after {
      content: '';
      position: absolute;
      inset-inline-start: -6px;
      top: 50%;
      transform: translateY(-50%);
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--bg);
      border: 1.3px solid var(--border);
    }

    .bz-row .bz-thumb {
      width: 52px;
      height: 52px;
      border-radius: 10px;
      object-fit: cover;
      flex-shrink: 0;
      background: var(--accent-peach);
    }

    .bz-row .bz-info {
      flex: 1;
      min-width: 0;
    }

    .bz-row .bz-info .n {
      font-size: 12.5px;
      font-weight: 700;
      margin: 0 0 2px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .bz-row .bz-info .p {
      font-size: 12px;
      font-weight: 800;
      color: var(--primary-dark);
      margin: 0;
    }

    .bz-row .bz-actions {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .bz-mini-btn {
      padding: 6px 10px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: none;
      font-family: 'Manrope';
      font-weight: 700;
      font-size: 10px;
      cursor: pointer;
      white-space: nowrap;
      transition: transform .12s ease, background .15s ease;
    }

    .bz-mini-btn:active {
      transform: scale(.92);
    }

    .bz-mini-btn.photo {
      color: var(--primary-dark);
    }

    .bz-mini-btn.del {
      color: var(--red);
    }

    .print-all-btn {
      margin: 0 18px 16px;
      padding: 13px;
      border: none;
      border-radius: 14px;
      background: linear-gradient(120deg, var(--bz-gold-2), var(--bz-gold-1));
      color: #fff;
      font-family: 'Manrope';
      font-weight: 700;
      font-size: 13.5px;
      cursor: pointer;
      transition: transform .12s ease, box-shadow .15s ease;
      box-shadow: 0 6px 14px rgba(194, 83, 12, .25);
    }

    .print-all-btn:active {
      transform: scale(.97);
    }

    /* Sell section */
    .seller-gate {
      margin: 0 18px 14px;
    }

    .scan-btn {
      margin: 0 18px 14px;
      padding: 16px;
      border: none;
      border-radius: 16px;
      background: var(--dark);
      color: #fff;
      font-family: 'Manrope';
      font-weight: 800;
      font-size: 15px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      animation: bzPulseRing 2.4s ease-in-out infinite;
      transition: transform .12s ease;
    }

    .scan-btn:active {
      transform: scale(.97);
    }

    .scan-btn.is-scanning {
      animation: none;
      background: var(--red);
    }

    #bzReaderWrap {
      position: relative;
      margin: 0 18px 14px;
      border-radius: 16px;
      overflow: hidden;
      display: none;
      border: 1.3px solid var(--border);
      animation: bzFadeUp .3s ease both;
    }

    #bzScanSweep {
      position: absolute;
      left: 0;
      right: 0;
      height: 2px;
      z-index: 5;
      pointer-events: none;
      background: linear-gradient(90deg, transparent, var(--bz-gold-1), transparent);
      box-shadow: 0 0 10px 2px rgba(231, 163, 62, .7);
      animation: bzSweep 2.1s ease-in-out infinite;
    }

    .bz-sale-card {
      margin: 0 18px 14px;
      padding: 14px;
      border-radius: 16px;
      border: 1.3px solid var(--border);
      background: var(--bz-paper);
      display: none;
    }

    .bz-sale-card.show {
      display: block;
      animation: bzPop .38s cubic-bezier(.34, 1.56, .64, 1) both;
    }

    .bz-sale-card img {
      width: 100%;
      height: 150px;
      object-fit: cover;
      border-radius: 12px;
      margin-bottom: 10px;
    }

    .bz-sale-card .sn {
      font-family: 'Fraunces', serif;
      font-weight: 600;
      font-size: 16px;
      margin: 0 0 4px;
    }

    .bz-sale-card .sp {
      font-size: 13.5px;
      color: var(--muted);
      margin: 0 0 12px;
    }

    .bz-sale-card .final {
      font-family: 'Fraunces', serif;
      font-weight: 700;
      font-size: 20px;
      color: var(--primary-dark);
      margin: 10px 0;
    }

    .confirm-sale-btn {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 14px;
      background: var(--green);
      color: #fff;
      font-family: 'Manrope';
      font-weight: 800;
      font-size: 14.5px;
      cursor: pointer;
      transition: transform .12s ease;
    }

    .confirm-sale-btn:active {
      transform: scale(.97);
    }

    .bz-sale-success {
      display: none;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 14px;
      border-radius: 14px;
      background: var(--green);
      color: #fff;
      font-family: 'Manrope';
      font-weight: 800;
      font-size: 14.5px;
    }

    .bz-sale-success.show {
      display: flex;
    }

    .bz-sale-success .check {
      display: inline-block;
      animation: bzCheckPop .45s ease both;
      font-size: 17px;
    }

    .cancel-sale-btn {
      width: 100%;
      padding: 10px;
      border: none;
      background: none;
      color: var(--muted);
      font-family: 'Manrope';
      font-weight: 700;
      font-size: 12.5px;
      cursor: pointer;
      margin-top: 6px;
    }

    .recent-sales-title {
      font-family: 'Fraunces', serif;
      font-weight: 600;
      font-size: 15px;
      padding: 6px 18px 8px;
    }

    .sale-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 14px;
      margin: 0 18px 8px;
      border: 1.3px solid var(--border);
      border-radius: 12px;
      background: #fff;
      animation: bzFadeUp .3s ease both;
    }

    .sale-item .l {
      font-size: 12.5px;
      font-weight: 700;
    }

    .sale-item .r {
      font-size: 12.5px;
      font-weight: 800;
      color: var(--primary-dark);
    }

    .sale-item .seller-tag {
      font-size: 10px;
      color: var(--muted);
      font-weight: 600;
    }

    /* Report section */
    .stat-row {
      display: flex;
      gap: 10px;
      padding: 0 18px 16px;
    }

    .stat-box {
      flex: 1;
      padding: 16px 14px;
      border-radius: 14px;
      text-align: center;
      background: linear-gradient(150deg, var(--accent-peach), #FFF3E4);
      border: 1px solid #F4DDBF;
      transition: transform .15s ease;
    }

    .stat-box .v {
      font-family: 'Fraunces', serif;
      font-weight: 700;
      font-size: 22px;
      color: var(--primary-dark);
    }

    .stat-box .l {
      font-size: 10.5px;
      color: var(--muted);
      font-weight: 700;
      margin-top: 2px;
    }

    .seller-breakdown {
      padding: 0 18px 20px;
    }

    .sb-row {
      display: flex;
      justify-content: space-between;
      padding: 9px 0;
      border-bottom: 1px solid var(--border);
      font-size: 12.5px;
      animation: bzFadeUp .3s ease both;
    }

    .sb-row b {
      color: var(--primary-dark);
    }
  </style>
</head>

<body>

  <div class="app" id="appRoot" style="display:none;">
    <div class="panels">

      <!-- ORDERS -->
      <div class="panel active" id="panel-orders">
        <div class="topbar">
          <div class="brand">
            <img class="logo" src="logo.png" alt="Beleco" />
            <span class="admin-badge">ADMIN</span>
          </div>
          <button class="exit-btn" id="exitBtn">للأبلكيشن العادي</button>
        </div>
        <div class="placeholder">
          <div class="icon-wrap">
            <svg viewBox="0 0 24 24">
              <rect x="5" y="2.5" width="14" height="19" rx="2" />
              <path d="M8.5 7h7M8.5 11h.01M12 11h.01M15.5 11h.01M8.5 14.5h.01M12 14.5h.01M15.5 14.5h.01M8.5 18h7" />
            </svg>
          </div>
          <h2>الأوردرات</h2>
          <p>هنا هتشوف كل الأوردرات، عددهم، وحالة كل واحد — قريبًا.</p>
        </div>
      </div>

      <!-- LISTINGS / POSTS -->
      <div class="panel" id="panel-listings">
        <div class="dash-header">
          <p class="dash-title">إضافة منتج جديد</p>
        </div>
        <div class="upload-form">
          <div class="df-field">
            <label>لينك المنتج من الموقع الأصلي</label>
            <div style="display:flex; gap:8px;">
              <input type="url" id="extractLinkInput" placeholder="https://..." style="flex:1;" />
              <button id="extractBtn"
                style="flex-shrink:0; padding:0 16px; border:none; border-radius:12px; background:var(--dark); color:#fff; font-family:'Manrope'; font-weight:700; font-size:12.5px; cursor:pointer;">استخراج
                تلقائي</button>
            </div>
            <p id="extractStatus" style="font-size:11.5px; color:var(--muted); margin-top:6px;"></p>
          </div>

          <div class="image-drop" id="imageDropZone">
            <img id="imagePreview" />
            <span id="imageDropText">دوسي هنا لاختيار صورة المنتج</span>
          </div>
          <input type="file" id="productImageInput" accept="image/*" style="display:none;" />

          <div class="df-field">
            <label>اسم المنتج</label>
            <input type="text" id="productNameInput" placeholder="مثال: فستان صيفي" />
          </div>
          <div class="df-field">
            <label>السعر (جنيه)</label>
            <input type="text" id="productPriceInput" placeholder="مثال: 650" />
          </div>
          <div class="df-field">
            <label>مكان الظهور (تقدري تختاري أكتر من واحد)</label>
            <div class="placements-grid">
              <label class="placement-chip"><input type="checkbox" value="trend" checked /><span>ترند
                  الأسبوع</span></label>
              <label class="placement-chip"><input type="checkbox" value="fashion" /><span>فاشون</span></label>
              <label class="placement-chip"><input type="checkbox" value="beauty" /><span>بيوتي</span></label>
              <label class="placement-chip"><input type="checkbox" value="homeware" /><span>هوم وير</span></label>
              <label class="placement-chip"><input type="checkbox" value="summer" /><span>صيف 2026</span></label>
              <label class="placement-chip"><input type="checkbox" value="picks" /><span>اختيارات
                  المؤثرين</span></label>
            </div>
          </div>
          <div class="df-field">
            <label>القسم (Women/Kids/Premium...)</label>
            <select id="productCategoryInput">
              <option value="women">حريمي</option>
              <option value="kids">أطفال</option>
              <option value="premium">بريميوم</option>
              <option value="sale">تخفيضات</option>
              <option value="general">عام</option>
            </select>
          </div>
          <div class="df-field">
            <label>لينك المنتج (اختياري)</label>
            <input type="url" id="productLinkInput" placeholder="https://..." />
          </div>
          <div class="df-field">
            <label>اللون (لو معروف)</label>
            <input type="text" id="productColorInput" placeholder="مثال: أحمر" />
          </div>
          <div class="df-field">
            <label>المقاس (لو معروف)</label>
            <input type="text" id="productSizeInput" placeholder="مثال: M" />
          </div>

          <button class="upload-submit-btn" id="uploadProductBtn">نشر المنتج</button>
          <p class="upload-note" id="uploadNote">تم النشر بنجاح ✓</p>
          <p class="upload-error" id="uploadError"></p>
        </div>

        <p class="products-section-title">المنتجات المنشورة</p>
        <div class="products-grid" id="productsGrid">
          <p style="grid-column:1/-1; color:var(--muted); font-size:13px; text-align:center; padding:20px;">بنجيب
            المنتجات...</p>
        </div>
      </div>

      <!-- BAZAAR (admin only, not visible to customers) -->
      <div class="panel" id="panel-bazaar">
        <div class="dash-header">
          <p class="dash-title">🎪 بازار بيليكو</p>
        </div>
        <div class="bz-header-strip"></div>
        <div class="bazaar-subnav" id="bazaarSubnav">
          <div class="bz-subnav-track"></div>
          <div class="bz-subnav-indicator" id="bzSubnavIndicator"></div>
          <button class="bz-pill active" data-bz="setup">إعداد</button>
          <button class="bz-pill" data-bz="sell">بيع</button>
          <button class="bz-pill" data-bz="report">تقرير</button>
        </div>

        <!-- SETUP -->
        <div class="bz-section active" id="bz-setup">
          <div class="bz-card">
            <h3>استيراد المنتجات (Excel / CSV)</h3>
            <p class="hint">لازم يكون فيه عمود اسمه "اسم" أو "name" وعمود "سعر" أو "price". كل صف هيتحول لمنتج وليه QR
              خاص بيه.</p>
            <button class="bz-file-btn" id="bzExcelBtn">اختاري ملف Excel / CSV</button>
            <input type="file" id="bzExcelInput" accept=".xlsx,.xls,.csv" style="display:none;" />
            <p class="bz-status" id="bzExcelStatus"></p>
          </div>

          <div class="bz-card">
            <h3>إضافة منتج واحد بسرعة</h3>
            <div class="bz-inline" style="margin-bottom:8px;">
              <input type="text" id="bzQuickName" placeholder="اسم المنتج" />
            </div>
            <div class="bz-inline">
              <input type="text" id="bzQuickPrice" placeholder="السعر" />
              <button id="bzQuickAddBtn">إضافة</button>
            </div>
          </div>

          <button class="print-all-btn" id="bzPrintAllBtn">🖨 طباعة كل التاجات (QR)</button>

          <p class="products-section-title" style="padding-top:0;">منتجات البازار (<span id="bzCount">0</span>)</p>
          <div class="bz-list" id="bzProductsList">
            <p style="color:var(--muted); font-size:13px; text-align:center; padding:20px;">لسه مفيش منتجات مضافة
              للبازار.</p>
          </div>
        </div>

        <!-- SELL -->
        <div class="bz-section" id="bz-sell">
          <div class="bz-card seller-gate" id="bzSellerGate">
            <h3>مين البياع؟</h3>
            <p class="hint">هيتسجل اسمك مع كل عملية بيع تعمليها من الجهاز ده.</p>
            <div class="bz-inline">
              <input type="text" id="bzSellerNameInput" placeholder="اكتب اسمك" />
              <button id="bzSaveSellerBtn">حفظ</button>
            </div>
          </div>

          <div id="bzSellerActive" style="display:none;">
            <p style="padding:0 18px 10px; font-size:12.5px; color:var(--muted);">بتبيع باسم: <b id="bzSellerNameShow"
                style="color:var(--text);"></b> · <span id="bzChangeSellerLink"
                style="color:var(--primary-dark); font-weight:700; cursor:pointer;">تغيير</span></p>

            <button class="scan-btn" id="bzScanBtn">📷 امسح QR بتاع المنتج</button>
            <div id="bzReaderWrap">
              <div id="bzScanSweep"></div>
              <div id="bzReader" style="width:100%;"></div>
            </div>

            <div class="bz-sale-card" id="bzSaleCard">
              <img id="bzSaleImg" src="" alt="" />
              <p class="sn" id="bzSaleName"></p>
              <p class="sp" id="bzSalePrice"></p>
              <div class="df-field">
                <label>خصم (جنيه، سيبيه صفر لو من غير خصم)</label>
                <input type="number" id="bzDiscountInput" placeholder="0" value="0" />
              </div>
              <p class="final" id="bzFinalPrice"></p>
              <button class="confirm-sale-btn" id="bzConfirmSaleBtn">✓ تم البيع</button>
              <button class="cancel-sale-btn" id="bzCancelSaleBtn">إلغاء</button>
            </div>
            <div class="bz-sale-success" id="bzSaleSuccess"><span class="check">✓</span> <span>تم تسجيل البيع
                بنجاح</span></div>

            <p class="recent-sales-title">آخر المبيعات (من الجهاز ده وغيره)</p>
            <div id="bzRecentSales"></div>
          </div>
        </div>

        <!-- REPORT -->
        <div class="bz-section" id="bz-report">
          <div class="stat-row">
            <div class="stat-box">
              <div class="v" id="bzStatCount">0</div>
              <div class="l">قطعة اتباعت</div>
            </div>
            <div class="stat-box">
              <div class="v" id="bzStatRevenue">0</div>
              <div class="l">إجمالي (ج.م)</div>
            </div>
          </div>
          <p class="products-section-title" style="padding-top:0;">حسب البياع</p>
          <div class="seller-breakdown" id="bzSellerBreakdown">
            <p style="color:var(--muted); font-size:13px; text-align:center; padding:10px 0;">لسه مفيش مبيعات.</p>
          </div>
          <p class="products-section-title">كل المبيعات</p>
          <div id="bzAllSales" style="padding-bottom:100px;"></div>
        </div>
      </div>

      <!-- INSIGHTS -->
      <div class="panel" id="panel-insights">
        <div class="placeholder">
          <div class="icon-wrap">
            <svg viewBox="0 0 24 24">
              <path d="M3 20h18" />
              <rect x="5" y="12" width="3" height="8" rx="1" />
              <rect x="10.5" y="7" width="3" height="13" rx="1" />
              <rect x="16" y="3" width="3" height="17" rx="1" />
            </svg>
          </div>
          <h2>الإحصائيات</h2>
          <p>هنا هتشوفي أداء بيليكو — مبيعات، طلبات، تفاعل — قريبًا.</p>
        </div>
      </div>

      <!-- REELS POSTING -->
      <div class="panel" id="panel-reels-admin">
        <div class="dash-header">
          <p class="dash-title">نشر فيديو Reel جديد</p>
        </div>
        <div class="upload-form">
          <div class="image-drop" id="videoDropZone">
            <video id="videoPreview" style="max-width:100%; max-height:160px; border-radius:10px; display:none;"
              muted></video>
            <span id="videoDropText">دوسي هنا لاختيار فيديو</span>
          </div>
          <input type="file" id="reelVideoInput" accept="video/*" style="display:none;" />

          <div class="df-field">
            <label>اسم صانع المحتوى</label>
            <input type="text" id="reelCreatorInput" placeholder="مثال: @creator_name" />
          </div>
          <div class="df-field">
            <label>الوصف</label>
            <input type="text" id="reelCaptionInput" placeholder="وصف قصير للفيديو" />
          </div>

          <button class="upload-submit-btn" id="uploadReelBtn">نشر الفيديو</button>
          <p class="upload-note" id="reelUploadNote">تم النشر بنجاح ✓</p>
          <p class="upload-error" id="reelUploadError"></p>
        </div>

        <p class="products-section-title">الفيديوهات المنشورة</p>
        <div id="reelsAdminList" style="padding:0 18px 100px;">
          <p style="color:var(--muted); font-size:13px; text-align:center; padding:20px;">بنجيب الفيديوهات...</p>
        </div>
      </div>

    </div>

    <nav class="tabbar">
      <button class="tab-btn active" data-panel="orders">
        <svg viewBox="0 0 24 24">
          <rect x="5" y="2.5" width="14" height="19" rx="2" />
          <path d="M8.5 7h7M8.5 11h.01M12 11h.01M15.5 11h.01M8.5 14.5h.01M12 14.5h.01M15.5 14.5h.01M8.5 18h7" />
        </svg>
        <span>الأوردرات</span>
      </button>
      <button class="tab-btn" data-panel="listings">
        <svg viewBox="0 0 24 24">
          <rect x="3" y="3" width="7" height="7" rx="1.5" />
          <rect x="14" y="3" width="7" height="7" rx="1.5" />
          <rect x="3" y="14" width="7" height="7" rx="1.5" />
          <rect x="14" y="14" width="7" height="7" rx="1.5" />
        </svg>
        <span>المنتجات</span>
      </button>
      <button class="tab-btn" data-panel="bazaar">
        <svg viewBox="0 0 24 24">
          <rect x="3" y="3" width="7" height="7" rx="1" />
          <rect x="14" y="3" width="7" height="7" rx="1" />
          <rect x="3" y="14" width="7" height="7" rx="1" />
          <path d="M14 14h3v3h-3zM20 14v3M14 20h3M17.5 17.5h3v3h-3z" />
        </svg>
        <span>البازار</span>
      </button>
      <button class="tab-btn" data-panel="insights">
        <svg viewBox="0 0 24 24">
          <path d="M3 20h18" />
          <rect x="5" y="12" width="3" height="8" rx="1" />
          <rect x="10.5" y="7" width="3" height="13" rx="1" />
          <rect x="16" y="3" width="3" height="17" rx="1" />
        </svg>
        <span>الإحصائيات</span>
      </button>
      <button class="tab-btn" data-panel="reels-admin">
        <svg viewBox="0 0 24 24">
          <rect x="3" y="4" width="18" height="16" rx="3" />
          <path d="M9.5 9.5 15 12l-5.5 2.5v-5z" />
        </svg>
        <span>Reels</span>
      </button>
    </nav>
  </div>

  <div class="gate" id="gateScreen">
    <p id="gateMessage">بنتأكد من حسابك...</p>
  </div>

  <!-- Libraries used only by the Bazaar tab -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode/1.4.4/qrcode.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
    import { getAuth, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
    import { initializeFirestore, persistentLocalCache, persistentMultipleTabManager, collection, addDoc, deleteDoc, doc, query, orderBy, onSnapshot, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
    import { getStorage, ref, uploadBytes, getDownloadURL, deleteObject } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-storage.js";

    const ADMIN_EMAILS = ["belleco.eg@gmail.com", "admin@beleco-admin.local", "ziadhh2003@gmail.com"];

    const firebaseConfig = {
      apiKey: "AIzaSyAhu8GZoXw-_MdqGPt63ZDB4Srpfzq-Cm4",
      authDomain: "beleco-orders.firebaseapp.com",
      projectId: "beleco-orders",
      storageBucket: "beleco-orders.firebasestorage.app",
      messagingSenderId: "865521869863",
      appId: "1:865521869863:web:7dcfb86a4e9af542131a02"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    // offline persistence — critical for the bazaar tab to work with weak/no wifi
    const db = initializeFirestore(app, {
      localCache: persistentLocalCache({ tabManager: persistentMultipleTabManager() })
    });
    const storage = getStorage(app);

    onAuthStateChanged(auth, (user) => {
      const gate = document.getElementById("gateScreen");
      const root = document.getElementById("appRoot");

      if (!user) {
        window.location.href = "login.html";
        return;
      }
      if (!ADMIN_EMAILS.includes(user.email)) {
        document.getElementById("gateMessage").innerHTML =
          'الصفحة دي مخصصة لصاحب الحساب بس. <a href="app.html">ارجعي للأبلكيشن</a>';
        gate.style.display = "flex";
        root.style.display = "none";
        return;
      }
      gate.style.display = "none";
      root.style.display = "flex";
    });

    document.getElementById("exitBtn").addEventListener("click", () => {
      window.location.href = "app.html";
    });

    const tabBtns = document.querySelectorAll(".tab-btn");
    const panels = document.querySelectorAll(".panel");
    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        tabBtns.forEach((b) => b.classList.remove("active"));
        panels.forEach((p) => p.classList.remove("active"));
        btn.classList.add("active");
        document.getElementById("panel-" + btn.dataset.panel).classList.add("active");
      });
    });

    /* ---------------- Auto-extract product info from URL ---------------- */
    const EXTRACT_URL = "https://us-central1-beleco-orders.cloudfunctions.net/extractProductInfo";
    let extractedImageUrl = null;

    document.getElementById("extractBtn").addEventListener("click", async () => {
      const statusEl = document.getElementById("extractStatus");
      const url = document.getElementById("extractLinkInput").value.trim();
      if (!url) {
        statusEl.textContent = "الرجاء لصق لينك المنتج الأول";
        statusEl.style.color = "var(--red)";
        return;
      }
      statusEl.textContent = "بنستخرج البيانات...";
      statusEl.style.color = "var(--muted)";

      try {
        const res = await fetch(EXTRACT_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ url }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "حصل خطأ");

        const found = [];
        if (data.title) { document.getElementById("productNameInput").value = data.title; found.push("الاسم"); }
        if (data.price) { document.getElementById("productPriceInput").value = data.price; found.push("السعر"); }
        if (data.color) { document.getElementById("productColorInput").value = data.color; found.push("اللون"); }
        if (data.size) { document.getElementById("productSizeInput").value = data.size; found.push("المقاس"); }
        document.getElementById("productLinkInput").value = url;

        if (data.image) {
          extractedImageUrl = data.image;
          const preview = document.getElementById("imagePreview");
          preview.src = data.image;
          preview.style.display = "block";
          document.getElementById("imageDropText").style.display = "none";
          selectedImageFile = null;
          found.push("الصورة");
        }

        statusEl.textContent = found.length
          ? `✓ اتجابت: ${found.join("، ")}. كمّلي أي حاجة ناقصة يدوي.`
          : "معرفناش نجيب أي بيانات — أدخلي البيانات يدوي من فضلك.";
        statusEl.style.color = found.length ? "var(--green)" : "var(--red)";
      } catch (err) {
        statusEl.textContent = "حصل خطأ في الاستخراج، أدخلي البيانات يدوي من فضلك.";
        statusEl.style.color = "var(--red)";
      }
    });

    /* ---------------- Product upload ---------------- */
    let selectedImageFile = null;

    document.getElementById("imageDropZone").addEventListener("click", () => {
      document.getElementById("productImageInput").click();
    });

    document.getElementById("productImageInput").addEventListener("change", (e) => {
      const file = e.target.files[0];
      if (!file) return;
      selectedImageFile = file;
      extractedImageUrl = null;
      const preview = document.getElementById("imagePreview");
      preview.src = URL.createObjectURL(file);
      preview.style.display = "block";
      document.getElementById("imageDropText").style.display = "none";
    });

    document.getElementById("uploadProductBtn").addEventListener("click", async () => {
      const errorEl = document.getElementById("uploadError");
      const noteEl = document.getElementById("uploadNote");
      errorEl.style.display = "none";
      noteEl.style.display = "none";

      const name = document.getElementById("productNameInput").value.trim();
      const price = document.getElementById("productPriceInput").value.trim();
      const category = document.getElementById("productCategoryInput").value;
      const link = document.getElementById("productLinkInput").value.trim();
      const color = document.getElementById("productColorInput").value.trim();
      const size = document.getElementById("productSizeInput").value.trim();
      const placements = Array.from(document.querySelectorAll(".placement-chip input:checked")).map((c) => c.value);

      if (!selectedImageFile && !extractedImageUrl) {
        errorEl.textContent = "الرجاء اختيار صورة أو استخراجها من اللينك";
        errorEl.style.display = "block";
        return;
      }
      if (!name || !price) {
        errorEl.textContent = "الرجاء كتابة اسم المنتج والسعر";
        errorEl.style.display = "block";
        return;
      }

      const btn = document.getElementById("uploadProductBtn");
      btn.disabled = true;
      btn.textContent = "بننشر...";

      try {
        let imageUrl, filePath;
        if (selectedImageFile) {
          filePath = `products/${Date.now()}_${selectedImageFile.name}`;
          const storageRef = ref(storage, filePath);
          await uploadBytes(storageRef, selectedImageFile);
          imageUrl = await getDownloadURL(storageRef);
        } else {
          imageUrl = extractedImageUrl;
          filePath = null;
        }

        await addDoc(collection(db, "products"), {
          name,
          price,
          category,
          color: color || null,
          size: size || null,
          placements: placements.length ? placements : ["trend"],
          link: link || null,
          imageUrl,
          imagePath: filePath,
          createdAt: serverTimestamp(),
        });

        noteEl.style.display = "block";
        document.getElementById("productNameInput").value = "";
        document.getElementById("productPriceInput").value = "";
        document.getElementById("productLinkInput").value = "";
        document.getElementById("productColorInput").value = "";
        document.getElementById("productSizeInput").value = "";
        document.getElementById("extractLinkInput").value = "";
        document.getElementById("extractStatus").textContent = "";
        document.getElementById("imagePreview").style.display = "none";
        document.getElementById("imageDropText").style.display = "block";
        document.getElementById("productImageInput").value = "";
        document.querySelectorAll(".placement-chip input").forEach((c) => { c.checked = c.value === "trend"; });
        selectedImageFile = null;
        extractedImageUrl = null;
        setTimeout(() => { noteEl.style.display = "none"; }, 2500);
      } catch (err) {
        errorEl.textContent = "حصل خطأ أثناء النشر، جرّبي تاني";
        errorEl.style.display = "block";
      }

      btn.disabled = false;
      btn.textContent = "نشر المنتج";
    });

    /* ---------------- Reel upload ---------------- */
    let selectedVideoFile = null;

    document.getElementById("videoDropZone").addEventListener("click", () => {
      document.getElementById("reelVideoInput").click();
    });

    document.getElementById("reelVideoInput").addEventListener("change", (e) => {
      const file = e.target.files[0];
      if (!file) return;
      selectedVideoFile = file;
      const preview = document.getElementById("videoPreview");
      preview.src = URL.createObjectURL(file);
      preview.style.display = "block";
      document.getElementById("videoDropText").style.display = "none";
    });

    document.getElementById("uploadReelBtn").addEventListener("click", async () => {
      const errorEl = document.getElementById("reelUploadError");
      const noteEl = document.getElementById("reelUploadNote");
      errorEl.style.display = "none";
      noteEl.style.display = "none";

      const creator = document.getElementById("reelCreatorInput").value.trim();
      const caption = document.getElementById("reelCaptionInput").value.trim();

      if (!selectedVideoFile) {
        errorEl.textContent = "الرجاء اختيار فيديو";
        errorEl.style.display = "block";
        return;
      }

      const btn = document.getElementById("uploadReelBtn");
      btn.disabled = true;
      btn.textContent = "بننشر...";

      try {
        const filePath = `reels/${Date.now()}_${selectedVideoFile.name}`;
        const storageRef = ref(storage, filePath);
        await uploadBytes(storageRef, selectedVideoFile);
        const videoUrl = await getDownloadURL(storageRef);

        await addDoc(collection(db, "reels"), {
          creator: creator || "Beleco",
          caption: caption || "",
          videoUrl,
          videoPath: filePath,
          createdAt: serverTimestamp(),
        });

        noteEl.style.display = "block";
        document.getElementById("reelCreatorInput").value = "";
        document.getElementById("reelCaptionInput").value = "";
        document.getElementById("videoPreview").style.display = "none";
        document.getElementById("videoDropText").style.display = "block";
        document.getElementById("reelVideoInput").value = "";
        selectedVideoFile = null;
        setTimeout(() => { noteEl.style.display = "none"; }, 2500);
      } catch (err) {
        errorEl.textContent = "حصل خطأ أثناء النشر، جرّبي تاني";
        errorEl.style.display = "block";
      }

      btn.disabled = false;
      btn.textContent = "نشر الفيديو";
    });

    onSnapshot(query(collection(db, "reels"), orderBy("createdAt", "desc")), (snap) => {
      const list = document.getElementById("reelsAdminList");
      if (snap.empty) {
        list.innerHTML = '<p style="color:var(--muted); font-size:13px; text-align:center; padding:20px;">لسه مفيش فيديوهات منشورة.</p>';
        return;
      }
      list.innerHTML = snap.docs.map((d) => {
        const r = d.data();
        return `
        <div style="display:flex; align-items:center; gap:12px; padding:10px; border:1.3px solid var(--border); border-radius:14px; margin-bottom:10px;">
          <video src="${r.videoUrl}" style="width:56px; height:76px; object-fit:cover; border-radius:8px;" muted></video>
          <div style="flex:1; min-width:0;">
            <p style="font-size:12.5px; font-weight:700; margin:0 0 2px;">${r.creator}</p>
            <p style="font-size:11.5px; color:var(--muted); margin:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">${r.caption}</p>
          </div>
          <button class="pt-delete" data-id="${d.id}" data-path="${r.videoPath || ""}" style="width:auto; padding:8px 12px;">حذف</button>
        </div>`;
      }).join("");

      list.querySelectorAll(".pt-delete").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = btn.dataset.id;
          const path = btn.dataset.path;
          btn.disabled = true;
          try {
            await deleteDoc(doc(db, "reels", id));
            if (path) { try { await deleteObject(ref(storage, path)); } catch (e) { } }
          } catch (e) {
            btn.disabled = false;
          }
        });
      });
    });
    const CATEGORY_LABELS = { women: "حريمي", kids: "أطفال", premium: "بريميوم", sale: "تخفيضات", general: "عام" };

    onSnapshot(query(collection(db, "products"), orderBy("createdAt", "desc")), (snap) => {
      const grid = document.getElementById("productsGrid");
      if (snap.empty) {
        grid.innerHTML = '<p style="grid-column:1/-1; color:var(--muted); font-size:13px; text-align:center; padding:20px;">لسه مفيش منتجات منشورة.</p>';
        return;
      }
      grid.innerHTML = snap.docs.map((d) => {
        const p = d.data();
        return `
        <div class="product-tile">
          <img src="${p.imageUrl}" alt="${p.name}" />
          <div class="pt-body">
            <p class="pt-name">${p.name}</p>
            <p class="pt-price">${p.price} ج.م</p>
            <button class="pt-delete" data-id="${d.id}" data-path="${p.imagePath || ""}">حذف</button>
          </div>
        </div>`;
      }).join("");

      grid.querySelectorAll(".pt-delete").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = btn.dataset.id;
          const path = btn.dataset.path;
          btn.disabled = true;
          btn.textContent = "...";
          try {
            await deleteDoc(doc(db, "products", id));
            if (path) {
              try { await deleteObject(ref(storage, path)); } catch (e) { /* ignore */ }
            }
          } catch (e) {
            btn.disabled = false;
            btn.textContent = "حذف";
          }
        });
      });
    });

    /* =================================================================
       BAZAAR TAB
       Collections: bazaarProducts, bazaarSales
       Uses client-side timestamps (Date.now()) everywhere instead of
       serverTimestamp() so everything keeps working while offline —
       serverTimestamp() resolves to null until the write syncs, which
       would break sorting/display at the event if wifi is weak.
    ================================================================= */

    // --- sub-nav (إعداد / بيع / تقرير) with sliding indicator ---
    function moveBzIndicator(pill) {
      const track = document.getElementById("bazaarSubnav");
      const indicator = document.getElementById("bzSubnavIndicator");
      if (!track || !indicator || !pill) return;
      const trackRect = track.getBoundingClientRect();
      const pillRect = pill.getBoundingClientRect();
      indicator.style.width = pillRect.width + "px";
      indicator.style.transform = `translateX(${pillRect.left - trackRect.left - 18}px)`;
    }
    document.querySelectorAll(".bz-pill").forEach((pill) => {
      pill.addEventListener("click", () => {
        document.querySelectorAll(".bz-pill").forEach((p) => p.classList.remove("active"));
        document.querySelectorAll(".bz-section").forEach((s) => s.classList.remove("active"));
        pill.classList.add("active");
        document.getElementById("bz-" + pill.dataset.bz).classList.add("active");
        moveBzIndicator(pill);
      });
    });
    // set initial indicator position once layout is ready
    setTimeout(() => moveBzIndicator(document.querySelector(".bz-pill.active")), 150);
    document.querySelector('.tab-btn[data-panel="bazaar"]').addEventListener("click", () => {
      setTimeout(() => moveBzIndicator(document.querySelector(".bz-pill.active")), 60);
    });

    let bazaarProductsCache = []; // kept in memory for instant QR-scan lookup, even offline

    // --- live products list ---
    onSnapshot(query(collection(db, "bazaarProducts"), orderBy("createdAt", "desc")), (snap) => {
      bazaarProductsCache = snap.docs.map((d) => ({ id: d.id, ...d.data() }));
      document.getElementById("bzCount").textContent = bazaarProductsCache.length;

      const list = document.getElementById("bzProductsList");
      if (!bazaarProductsCache.length) {
        list.innerHTML = '<p style="color:var(--muted); font-size:13px; text-align:center; padding:20px;">لسه مفيش منتجات مضافة للبازار.</p>';
        return;
      }
      list.innerHTML = bazaarProductsCache.map((p) => `
      <div class="bz-row">
        ${p.imageUrl
          ? `<img class="bz-thumb" src="${p.imageUrl}" />`
          : `<div class="bz-thumb" style="display:flex;align-items:center;justify-content:center;font-size:9px;color:var(--muted);text-align:center;">من غير صورة</div>`}
        <div class="bz-info">
          <p class="n">${p.name}</p>
          <p class="p">${p.price} ج.م</p>
        </div>
        <div class="bz-actions">
          <button class="bz-mini-btn photo" data-photo="${p.id}">${p.imageUrl ? "تغيير الصورة" : "ارفع صورة"}</button>
          <button class="bz-mini-btn" data-print="${p.id}">طباعة QR</button>
          <button class="bz-mini-btn del" data-del="${p.id}" data-path="${p.imagePath || ""}">حذف</button>
        </div>
      </div>`).join("");

      list.querySelectorAll("[data-photo]").forEach((btn) => {
        btn.addEventListener("click", () => triggerBazaarPhotoUpload(btn.dataset.photo));
      });
      list.querySelectorAll("[data-print]").forEach((btn) => {
        btn.addEventListener("click", () => printTags([bazaarProductsCache.find(p => p.id === btn.dataset.print)]));
      });
      list.querySelectorAll("[data-del]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          if (!confirm("متأكد إنك عايز تمسح المنتج ده من البازار؟")) return;
          const id = btn.dataset.del;
          const path = btn.dataset.path;
          try {
            await deleteDoc(doc(db, "bazaarProducts", id));
            if (path) { try { await deleteObject(ref(storage, path)); } catch (e) { } }
          } catch (e) { alert("حصل خطأ، جرّب تاني"); }
        });
      });
    });

    // --- excel/csv import ---
    document.getElementById("bzExcelBtn").addEventListener("click", () => document.getElementById("bzExcelInput").click());
    document.getElementById("bzExcelInput").addEventListener("change", async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const statusEl = document.getElementById("bzExcelStatus");
      statusEl.className = "bz-status";
      statusEl.textContent = "بنقرأ الملف...";

      try {
        const data = await file.arrayBuffer();
        const wb = XLSX.read(data, { type: "array" });
        const sheet = wb.Sheets[wb.SheetNames[0]];
        const rows = XLSX.utils.sheet_to_json(sheet, { defval: "" });

        const nameKeys = ["name", "اسم", "الاسم", "product", "المنتج"];
        const priceKeys = ["price", "سعر", "السعر"];

        const items = rows.map((row) => {
          const keys = Object.keys(row);
          const nameKey = keys.find((k) => nameKeys.includes(k.toString().trim().toLowerCase()));
          const priceKey = keys.find((k) => priceKeys.includes(k.toString().trim().toLowerCase()));
          return {
            name: nameKey ? String(row[nameKey]).trim() : "",
            price: priceKey ? String(row[priceKey]).trim() : "",
          };
        }).filter((it) => it.name && it.price);

        if (!items.length) {
          statusEl.className = "bz-status err";
          statusEl.textContent = "معرفناش نلاقي أعمدة الاسم والسعر — تأكد من أسماء الأعمدة.";
          return;
        }

        statusEl.textContent = `بنضيف ${items.length} منتج...`;
        for (const it of items) {
          await addDoc(collection(db, "bazaarProducts"), {
            name: it.name,
            price: it.price,
            imageUrl: null,
            imagePath: null,
            createdAt: Date.now(),
          });
        }
        statusEl.className = "bz-status ok";
        statusEl.textContent = `✓ اتضاف ${items.length} منتج بنجاح.`;
      } catch (err) {
        statusEl.className = "bz-status err";
        statusEl.textContent = "حصل خطأ في قراءة الملف: " + (err.message || err);
        console.error("Bazaar Excel read error:", err);
      }
      document.getElementById("bzExcelInput").value = "";
    });

    // --- quick add single ---
    document.getElementById("bzQuickAddBtn").addEventListener("click", async () => {
      const name = document.getElementById("bzQuickName").value.trim();
      const price = document.getElementById("bzQuickPrice").value.trim();
      if (!name || !price) return;
      await addDoc(collection(db, "bazaarProducts"), {
        name, price, imageUrl: null, imagePath: null, createdAt: Date.now(),
      });
      document.getElementById("bzQuickName").value = "";
      document.getElementById("bzQuickPrice").value = "";
    });

    // --- per-product photo upload ---
    const bzPhotoInput = document.createElement("input");
    bzPhotoInput.type = "file";
    bzPhotoInput.accept = "image/*";
    bzPhotoInput.style.display = "none";
    document.body.appendChild(bzPhotoInput);
    let bzPhotoTargetId = null;

    function triggerBazaarPhotoUpload(productId) {
      bzPhotoTargetId = productId;
      bzPhotoInput.click();
    }
    bzPhotoInput.addEventListener("change", async (e) => {
      const file = e.target.files[0];
      if (!file || !bzPhotoTargetId) return;
      try {
        const filePath = `bazaarProducts/${Date.now()}_${file.name}`;
        const storageRef = ref(storage, filePath);
        await uploadBytes(storageRef, file);
        const imageUrl = await getDownloadURL(storageRef);
        // update via a fresh addDoc-style set: use deleteDoc/addDoc is wasteful, use direct field update
        const { updateDoc } = await import("https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js");
        await updateDoc(doc(db, "bazaarProducts", bzPhotoTargetId), { imageUrl, imagePath: filePath });
      } catch (err) {
        alert("حصل خطأ في رفع الصورة، جرّب تاني وأنت متاكد إن النت متصل.");
      }
      bzPhotoInput.value = "";
      bzPhotoTargetId = null;
    });

    // --- QR generation + printing ---
    async function printTags(products) {
      if (typeof QRCode === "undefined") {
        alert("مكتبة توليد QR معرفتش تتحمّل. تأكدي من اتصال الإنترنت وجرّبي تاني.");
        return;
      }
      const valid = products.filter(Boolean);
      if (!valid.length) return;
      const tagsHtml = await Promise.all(valid.map(async (p) => {
        const qrDataUrl = await QRCode.toDataURL(p.id, { width: 220, margin: 0 });
        return `<img src="${qrDataUrl}" class="qr-img" />`;
      }));

      const win = window.open("", "_blank");
      win.document.write(`
      <!DOCTYPE html><html><head><meta charset="UTF-8">
      <title>QR Codes</title>
      <style>
        body{ margin:0; padding:10px; display:flex; flex-wrap:wrap; gap:10px; }
        .qr-img{ width:120px; height:120px; display:block; page-break-inside:avoid; }
        @media print{ body{ padding:0; } }
      </style>
      </head><body>
        ${tagsHtml.join("")}
        <script>window.onload = () => window.print();<\/script>
      </body></html>
    `);
      win.document.close();
    }

    document.getElementById("bzPrintAllBtn").addEventListener("click", () => {
      if (!bazaarProductsCache.length) { alert("مفيش منتجات لسه"); return; }
      printTags(bazaarProductsCache);
    });

    // --- seller identity (per device) ---
    const SELLER_KEY = "beleco_bazaar_seller_name";
    function refreshSellerUI() {
      const name = localStorage.getItem(SELLER_KEY);
      if (name) {
        document.getElementById("bzSellerGate").style.display = "none";
        document.getElementById("bzSellerActive").style.display = "block";
        document.getElementById("bzSellerNameShow").textContent = name;
      } else {
        document.getElementById("bzSellerGate").style.display = "block";
        document.getElementById("bzSellerActive").style.display = "none";
      }
    }
    document.getElementById("bzSaveSellerBtn").addEventListener("click", () => {
      const name = document.getElementById("bzSellerNameInput").value.trim();
      if (!name) return;
      localStorage.setItem(SELLER_KEY, name);
      refreshSellerUI();
    });
    document.getElementById("bzChangeSellerLink").addEventListener("click", () => {
      localStorage.removeItem(SELLER_KEY);
      refreshSellerUI();
    });
    refreshSellerUI();

    // --- scanner ---
    let html5QrCode = null;
    let currentScannedProduct = null;

    document.getElementById("bzScanBtn").addEventListener("click", async () => {
      const wrap = document.getElementById("bzReaderWrap");
      const btn = document.getElementById("bzScanBtn");
      if (wrap.style.display === "block") {
        await stopScanner();
        wrap.style.display = "none";
        btn.textContent = "📷 امسح QR بتاع المنتج";
        btn.classList.remove("is-scanning");
        return;
      }
      wrap.style.display = "block";
      btn.textContent = "إيقاف الكاميرا";
      btn.classList.add("is-scanning");
      html5QrCode = new Html5Qrcode("bzReader");
      try {
        await html5QrCode.start(
          { facingMode: "environment" },
          { fps: 10, qrbox: 220 },
          async (decodedText) => {
            const product = bazaarProductsCache.find((p) => p.id === decodedText);
            if (!product) return; // ignore unrelated QR codes
            currentScannedProduct = product;
            showSaleCard(product);
            await stopScanner();
            wrap.style.display = "none";
            btn.textContent = "📷 امسح QR بتاع المنتج";
            btn.classList.remove("is-scanning");
          },
          () => { }
        );
      } catch (err) {
        alert("معرفناش نفتح الكاميرا. تأكد إنك سمحت للموقع بالوصول للكاميرا.");
        wrap.style.display = "none";
        btn.textContent = "📷 امسح QR بتاع المنتج";
        btn.classList.remove("is-scanning");
      }
    });

    async function stopScanner() {
      if (html5QrCode) {
        try { await html5QrCode.stop(); html5QrCode.clear(); } catch (e) { }
        html5QrCode = null;
      }
    }
    function showSaleCard(product) {
      document.getElementById("bzSaleImg").src = product.imageUrl || "";
      document.getElementById("bzSaleImg").style.display = product.imageUrl ? "block" : "none";
      document.getElementById("bzSaleName").textContent = product.name;
      document.getElementById("bzSalePrice").textContent = product.price + " ج.م";
      document.getElementById("bzDiscountInput").value = 0;
      updateFinalPrice();
      document.getElementById("bzSaleSuccess").classList.remove("show");
      document.getElementById("bzSaleCard").classList.add("show");
    }

    function updateFinalPrice() {
      if (!currentScannedProduct) return;
      const price = parseFloat(currentScannedProduct.price) || 0;
      const discount = parseFloat(document.getElementById("bzDiscountInput").value) || 0;
      const final = Math.max(price - discount, 0);
      document.getElementById("bzFinalPrice").textContent = `السعر النهائي: ${final} ج.م`;
    }
    document.getElementById("bzDiscountInput").addEventListener("input", updateFinalPrice);

    document.getElementById("bzCancelSaleBtn").addEventListener("click", () => {
      currentScannedProduct = null;
      document.getElementById("bzSaleCard").classList.remove("show");
    });

    document.getElementById("bzConfirmSaleBtn").addEventListener("click", async () => {
      if (!currentScannedProduct) return;
      const seller = localStorage.getItem(SELLER_KEY) || "غير معروف";
      const price = parseFloat(currentScannedProduct.price) || 0;
      const discount = parseFloat(document.getElementById("bzDiscountInput").value) || 0;
      const finalPrice = Math.max(price - discount, 0);

      const btn = document.getElementById("bzConfirmSaleBtn");
      btn.disabled = true;
      btn.textContent = "بنسجل...";

      try {
        // addDoc queues locally if offline and syncs automatically once online
        await addDoc(collection(db, "bazaarSales"), {
          productId: currentScannedProduct.id,
          productName: currentScannedProduct.name,
          price,
          discount,
          finalPrice,
          seller,
          soldAt: Date.now(),
        });
        currentScannedProduct = null;
        document.getElementById("bzSaleCard").classList.remove("show");
        const successEl = document.getElementById("bzSaleSuccess");
        successEl.classList.remove("show");
        void successEl.offsetWidth; // restart animation
        successEl.classList.add("show");
        setTimeout(() => successEl.classList.remove("show"), 2200);
      } catch (err) {
        alert("حصل خطأ، جرّب تاني");
      }
      btn.disabled = false;
      btn.textContent = "✓ تم البيع";
    });

    // --- animated count-up for stat numbers ---
    function animateCount(el, target) {
      const start = parseFloat(el.dataset.val || "0") || 0;
      if (start === target) return;
      el.dataset.val = target;
      const duration = 500;
      const startTime = performance.now();
      function tick(now) {
        const p = Math.min((now - startTime) / duration, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(start + (target - start) * eased);
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    // --- live sales feed + report with refund / delete support ---
    function renderSaleItem(s) {
      const timeStr = s.soldAt ? new Date(s.soldAt).toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' }) : '';
      return `
      <div class="sale-item" id="sale-${s.id}">
        <div style="flex:1; min-width:0; padding-inline-end:8px;">
          <div class="l">${s.productName}${s.discount ? ` <span style="font-size:11px; color:var(--red); font-weight:700;">(خصم ${s.discount} ج.م)</span>` : ''}</div>
          <div class="seller-tag">${s.seller || 'غير معروف'}${timeStr ? ' · ' + timeStr : ''}</div>
        </div>
        <div style="display:flex; align-items:center; gap:8px; flex-shrink:0;">
          <div class="r">${s.finalPrice} ج.م</div>
          <button class="bz-mini-btn del bz-refund-btn" data-sale-id="${s.id}" data-name="${s.productName}" data-price="${s.finalPrice}">استرجاع</button>
        </div>
      </div>`;
    }

    function attachRefundHandlers(container) {
      container.querySelectorAll(".bz-refund-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = btn.dataset.saleId;
          const name = btn.dataset.name;
          const price = btn.dataset.price;
          if (!id) return;
          const ok = confirm(`⚠️ تأكيد استرجاع / إلغاء بيع\n\nهل أنت متأكد من استرجاع هذا المنتج وإلغاء تسجيل العملية من النظام؟\n\n• المنتج: ${name}\n• المبلغ: ${price} ج.م\n\nسيتم حذف العملية وخصمها من الإجمالي والتقارير فوراً.`);
          if (!ok) return;

          try {
            btn.disabled = true;
            btn.textContent = "جاري...";
            await deleteDoc(doc(db, "bazaarSales", id));
          } catch (err) {
            alert("حصل خطأ أثناء حذف العملية: " + (err.message || err));
            btn.disabled = false;
            btn.textContent = "استرجاع";
          }
        });
      });
    }

    onSnapshot(query(collection(db, "bazaarSales"), orderBy("soldAt", "desc")), (snap) => {
      const sales = snap.docs.map((d) => ({ id: d.id, ...d.data() }));

      // recent sales (sell tab)
      const recentEl = document.getElementById("bzRecentSales");
      recentEl.innerHTML = sales.slice(0, 15).map(renderSaleItem).join("") || '<p style="color:var(--muted); font-size:12.5px; text-align:center; padding:14px 0;">لسه مفيش مبيعات.</p>';
      attachRefundHandlers(recentEl);

      // report tab
      const totalCount = sales.length;
      const totalRevenue = sales.reduce((sum, s) => sum + (s.finalPrice || 0), 0);
      animateCount(document.getElementById("bzStatCount"), totalCount);
      animateCount(document.getElementById("bzStatRevenue"), totalRevenue);

      const bySeller = {};
      sales.forEach((s) => {
        const seller = s.seller || "غير معروف";
        bySeller[seller] = bySeller[seller] || { count: 0, revenue: 0 };
        bySeller[seller].count += 1;
        bySeller[seller].revenue += s.finalPrice || 0;
      });
      const breakdownEl = document.getElementById("bzSellerBreakdown");
      const sellerNames = Object.keys(bySeller);
      breakdownEl.innerHTML = sellerNames.length
        ? sellerNames.map((name) => `
          <div class="sb-row"><span>${name}</span><b>${bySeller[name].count} قطعة — ${bySeller[name].revenue} ج.م</b></div>
        `).join("")
        : '<p style="color:var(--muted); font-size:13px; text-align:center; padding:10px 0;">لسه مفيش مبيعات.</p>';

      const allEl = document.getElementById("bzAllSales");
      allEl.innerHTML = sales.map(renderSaleItem).join("") || '<p style="color:var(--muted); font-size:13px; text-align:center; padding:14px 0;">لسه مفيش مبيعات.</p>';
      attachRefundHandlers(allEl);
    });
  </script>

</body>

</html>